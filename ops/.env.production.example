# ATLAS — production environment (Oracle VM)
# Copy to /etc/atlas.env, fill values, chmod 600
#
#   sudo cp /home/ubuntu/atlas/ops/.env.production.example /etc/atlas.env
#   sudo nano /etc/atlas.env
#   sudo chmod 600 /etc/atlas.env

# ── Next.js ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_BASE_URL=https://republic.suezcanal.xyz

# ── Cesium Ion ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CESIUM_TOKEN=your_cesium_ion_token_here

# ── Database (PostgreSQL on same VM) ──────────────────────────────────────────
# Install: sudo apt install postgresql-16 postgresql-16-postgis
# Setup:   sudo -u postgres createuser atlas && createdb atlas_db
#          psql atlas_db -c "CREATE EXTENSION postgis; CREATE EXTENSION vector;"
DATABASE_URL=postgresql://atlas:password@localhost:5432/atlas_db
DIRECT_URL=postgresql://atlas:password@localhost:5432/atlas_db

# ── AI — Ollama local (zero cost, always-on on Oracle ARM) ───────────────────
# Install Ollama: curl -fsSL https://ollama.com/install.sh | sh
# Pull model:     ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Optional: override with NIM or Groq if you want 70B quality
# NVIDIA_NIM_API_KEY=
# GROQ_API_KEY=

# ── Cron auth ─────────────────────────────────────────────────────────────────
# System cron calls the endpoint with this secret (see ops/crontab.txt)
CRON_SECRET=generate_random_secret_here

# ── Optional data sources ─────────────────────────────────────────────────────
ACLED_API_KEY=
NASA_FIRMS_KEY=
