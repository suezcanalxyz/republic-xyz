# Cesium Ion token — get free token at cesium.com/ion
# Same token used in SITI/investigation forensic map
NEXT_PUBLIC_CESIUM_TOKEN=your_cesium_ion_token_here

# Database — Neon, Supabase, or any Postgres with PostGIS + pgvector
DATABASE_URL=postgresql://user:password@host/republic_atlas?sslmode=require
DIRECT_URL=postgresql://user:password@host/republic_atlas?sslmode=require

# NVIDIA NIM — Llama 3.1 70B for signal enrichment, scoring, and generation
# Get key at: build.nvidia.com
NVIDIA_NIM_API_KEY=your_nim_api_key_here

# Cron auth — set to a random secret, add to Vercel project env vars
# Used in Authorization: Bearer <secret> header on /api/cron/refresh
CRON_SECRET=your_random_secret_here

# Public URL (used for absolute links in email/export)
NEXT_PUBLIC_BASE_URL=https://republic.suezcanal.xyz

# Optional: GDELT base URL override
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Optional: ACLED conflict data
ACLED_API_KEY=

# Optional: NASA FIRMS fire alerts
NASA_FIRMS_KEY=

# Optional: object storage for evidence media
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
